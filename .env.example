# ============================================================================
# Toroloom — Environment Variables (copy to .env and edit)
# ============================================================================
# Copy this file:
#   cp .env.example .env
# Then edit .env with your production values.
# Never commit .env to Git (it's in .gitignore).

# ── Required ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-hex-string
# Grafana admin password is REQUIRED for docker-compose.prod.yml (fail-fast).
# Generate: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=change-me-to-a-random-hex-string
# Optional but recommended: DB/Redis passwords override the internal defaults.
# Generate each with: openssl rand -hex 24
# POSTGRES_PASSWORD=change-me
# MONGO_PASSWORD=change-me
# REDIS_PASSWORD=change-me

# ── Storage (default: memory — no database needed) ─────────────────────────
# STORAGE_BACKEND=postgres
# Point to PgBouncer (port 6432) for connection pooling in production.
# For direct PostgreSQL (dev without PgBouncer): use port 5432.
# DATABASE_URL=postgresql://toroloom:your_password@pgbouncer:6432/toroloom
# POSTGRES_PASSWORD=your_password

# STORAGE_BACKEND=mongodb
# MONGODB_URI=mongodb://toroloom:your_password@mongodb:27017
# MONGO_PASSWORD=your_password
# MONGODB_DB_NAME=toroloom

# ── Broker (default: mock — no real trading) ───────────────────────────────
# BROKER=zerodha
# DATA_SOURCE=live
# ZERODHA_API_KEY=your_key
# ZERODHA_API_SECRET=your_secret
# ZERODHA_ACCESS_TOKEN=your_token

# BROKER=angel
# ANGEL_CLIENT_ID=your_client_id
# ANGEL_API_KEY=your_api_key
# ANGEL_ACCESS_TOKEN=your_token
# ANGEL_PASSWORD=your_password
# ANGEL_TOTP=your_totp_secret

# ── Optional ────────────────────────────────────────────────────────────────
# JWT_EXPIRES_IN=7d

# ── Frontend (Expo / EAS) — EXPO_PUBLIC_* ─────────────────────────────────
# Expo inlines EXPO_PUBLIC_* vars at bundle time. Set them here for local
# dev (`expo start`), or in eas.json env / EAS project secrets for builds.
#
# Backend API base URL — the app reads this in App.tsx via configureApi().
# Local dev (backend running via `npm run dev` in backend/):
EXPO_PUBLIC_API_URL=http://localhost:3000/api
#
# Production builds MUST point at your deployed Railway domain instead:
#   EXPO_PUBLIC_API_URL=https://<your-domain>.up.railway.app/api
#
# Sentry DSN — leave empty to disable crash reporting entirely.
EXPO_PUBLIC_SENTRY_DSN=
#
# EAS build variant — development | preview | production (controls bundle id
# and app name in app.config.js). Only needed for EAS builds.
# APP_VARIANT=development
