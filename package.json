    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.3.2",
    "@shopify/react-native-skia": "2.12.0",
    "@testing-library/react-native": "^13.3.3",
    "babel-preset-expo": "~56.0.0",
    "date-fns": "^4.4.0",
    "expo": "~56.0.15",
    "expo-background-fetch": "~56.0.21",
    "expo-clipboard": "~56.0.4",
    "expo-dev-client": "~56.0.22",
    "expo-device": "^56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-local-authentication": "~56.0.4",
    "expo-notifications": "~56.0.20",
    "expo-print": "~56.0.4",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.21",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.21",
    "expo-video": "~56.1.4",
    "i18next": "^26.4.2",
    "lightweight-charts": "^5.2.1",
    "lottie-react-native": "~7.5.0",
    "lz-string": "^1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.87.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keychain": "^10.0.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-toast-message": "^2.5.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.12.2",
    "snaptrade-typescript-sdk": "^10.0.18",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "qrcode-terminal": "^0.12.0",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.7"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay",
          "react-native-vector-icons",
          "expo-modules-jsi"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/clean-rn-razorpay-build.mjs",
    "clean:razorpay": "node scripts/clean-rn-razorpay-build.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:int": "bash scripts/run-integration-tests.sh",
    "test:int:coverage": "bash scripts/run-integration-tests.sh --coverage",
    "test:int:up": "bash scripts/run-integration-tests.sh --keep",
    "test:int:coverage:up": "bash scripts/run-integration-tests.sh --coverage --keep",
    "test:int:down": "bash scripts/run-integration-tests.sh --down",
    "test:e2e": "maestro test .maestro/flows",
    "test:e2e:studio": "maestro studio",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "lint": "eslint src/ --max-warnings=0",
    "test:e2e:ci": "maestro test .maestro/flows",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "screenshots:android": "bash scripts/capture-screenshots.sh --android-only",
    "screenshots:clean": "bash scripts/capture-screenshots.sh --clean",
    "screenshots:studio": "maestro studio",
    "screenshots:guide": "echo 'For iOS capture, run: maestro test .maestro/flows/screenshots/capture.yaml --app-id host.exp.Exponent'",
    "validate:imports": "node scripts/validate-imports.mjs",
    "check:i18n": "node scripts/check-locale-parity.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "verify:scripts": "node scripts/install-scripts-allowlist.mjs",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "doctor": "npx react-doctor@latest",
    "test:deeplinks": "bash scripts/test-deep-links.sh",
    "test:deeplinks:local": "bash scripts/test-deep-links.sh http://localhost:3000",
    "bundle:size": "node scripts/check-bundle-size.mjs",
    "bundle:size:update": "node scripts/check-bundle-size.mjs update-baseline",
    "rebuild:scripts": "node scripts/install-scripts-allowlist.mjs --rebuild --only=root"
  },
  "private": true
}
