# ==============================================================================
# Toroloom Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and fill in your credentials:
#   cp backend/.env.example backend/.env
#
# Production checklist: see docs/PRODUCTION_ENV_CHECKLIST.md
# Authoritative reader: backend/src/config/env.ts (validateRequiredEnv)
# ==============================================================================

# ──── Server ──────────────────────────────────────────────────────────────────
PORT=3000                       # Railway auto-injects PORT — ignore there
NODE_ENV=development            # production in production
CLUSTER_MODE=0                  # Railway single-container: MUST be 0 (1 crashes the container)
# CLUSTER_WORKERS=4             # Worker count when CLUSTER_MODE=1 (default: CPU count)

# ──── JWT ────────────────────────────────────────────────────────────────────
# REQUIRED in production — startup fails if empty. Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ──── Data mode ───────────────────────────────────────────────────────────────
# Broker connections are handled by SnapTrade OAuth + the frontend session
# proxy (Zero-API gateway mandate). These flags select the data mode only:
#   BROKER       mock | zerodha | angel | groww      (legacy plugins)
#   DATA_SOURCE  mock | live
BROKER=mock
DATA_SOURCE=mock

# ──── Feature flags ───────────────────────────────────────────────────────────
SUBSCRIPTION_GATING_ENABLED=false   # true in production (402-gating middleware)

# ──── Storage backend ─────────────────────────────────────────────────────────
#   memory   -> InMemoryStorage (default, no deps)
#   postgres -> PostgreSQLStorage (requires DATABASE_URL)
#   mongodb  -> MongoDBStorage (requires MONGODB_URI + MONGODB_DB_NAME)
STORAGE_BACKEND=memory
# Point DATABASE_URL to PgBouncer (port 6432) in production.
# For direct PostgreSQL (e.g. local dev without PgBouncer): port 5432
DATABASE_URL=postgresql://toroloom:toroloom_dev@localhost:5432/toroloom
# Read replica for analytics offload (optional, falls back to DATABASE_URL)
# DATABASE_URL_READER=postgresql://toroloom:toroloom_dev@reader-host:6432/toroloom
MONGODB_URI=mongodb://toroloom:toroloom_dev@localhost:27017/toroloom?authSource=admin
MONGODB_DB_NAME=toroloom

# ──── CORS ────────────────────────────────────────────────────────────────────
# Restrict to your app domain(s) in production (comma-separated). The app
# warns loudly while this is '*' in production.
#   Example: CORS_ORIGIN=https://app.toroloom.com,https://admin.toroloom.com
CORS_ORIGIN=*

# ──── SnapTrade — unified broker OAuth (ALL 3 REQUIRED for trading) ──────────
# Get credentials: https://app.snaptrade.com → Settings → API Keys
SNAPTRADE_CLIENT_ID=            # e.g. PERS_xxxxxxxxxxxx (personal) or PARTNER_xxxx (commercial)
SNAPTRADE_CONSUMER_KEY=
# SNAPTRADE_MODE=personal       # personal = personal API keys (no registerUser, user auto-provisioned)
                                # commercial = partner API keys (default). Auto-detected from PERS- prefix.
# 256-bit key — REQUIRED in production for COMMERCIAL mode (user userSecrets
# are AES-256-GCM encrypted with it; prod warns if missing). Personal mode
# does not use userSecret. Generate: openssl rand -hex 32
SNAPTRADE_ENCRYPTION_KEY=

# ──── Razorpay — payments (all 3 REQUIRED for payments) ──────────────────────
# Get credentials: https://dashboard.razorpay.com → Settings → API Keys
# Use LIVE keys (rzp_live_*) in production — not rzp_test_*
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Generate: openssl rand -hex 32 — must match the webhook secret set in the
# Razorpay dashboard (webhook URL: /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=

# ──── AI — set at least one provider (prod warns if none) ────────────────────
#   AI_PROVIDER = openrouter (default) | google | choreo
AI_PROVIDER=openrouter
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
# Google AI Studio: https://aistudio.google.com
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.0-flash-lite-001
# Choreo API Gateway (Anthropic Claude — paid)
CHOREO_CLAUDE_API_KEY=
# CHOREO_CLAUDE_ENDPOINT=https://eg-.../default/anthropic-claude-api/v1.0
# CHOREO_CLAUDE_MODEL=claude-sonnet-4-20250514

# ──── Sentry (error tracking, optional) ───────────────────────────────────────
# Get DSN: https://sentry.io/settings/{org}/projects/{project}/keys/
# Leave empty to disable Sentry entirely.
SENTRY_DSN=

# ──── Redis (pub/sub + cache, optional) ──────────────────────────────────────
# Format: redis://[:password@]host[:port][/db]
# Railway Redis plugin auto-injects RAILWAY_REDIS_URL — no need to set here.
REDIS_URL=

# ──── Email (transactional, optional) ────────────────────────────────────────
# Get key: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_SENDER_EMAIL=noreply@toroloom.app

# ──── Broker extras (optional) ────────────────────────────────────────────────
# Angel One SmartAPI (server-level data): https://smartapi.angelbroking.com
ANGEL_SMARTAPI_KEY=
# Upstox OAuth 2.0 (optional): https://upstox.com/developer
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
# Interactive Brokers gateway (optional)
# IBKR_GATEWAY_URL=http://localhost:5000
# IBKR_ACCOUNT_ID=
# IBKR_ENABLED=true

# ──── Market data (optional) ──────────────────────────────────────────────────
MARKETSTACK_KEY=                # https://marketstack.com — real-time stock data
COMMODITY_API_KEY=              # https://api-ninjas.com — commodity prices
FRED_API_KEY=                   # https://fred.stlouisfed.org — US yields / bonds
NEWSAPI_KEY=                    # https://newsapi.org — financial news

# ──── Notifications (optional) ────────────────────────────────────────────────
# Telegram bot for trading alerts: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# ──── Database pool tuning (defaults are fine) ────────────────────────────────
# POOL_MAX=20
# READER_POOL_MAX=10
# STATEMENT_TIMEOUT_MS=30000

# ──── Cache tuning (defaults are fine) ────────────────────────────────────────
# BACKTEST_CACHE_TTL=3600
# MARKET_DATA_CACHE_TTL=600
# CACHE_MAX_ENTRIES=200
# DISABLE_CACHE=1

# ──── Rate limits (requests per window, defaults are fine) ────────────────────
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_WRITE_MAX=50
# RATE_LIMIT_READ_MAX=200
# RATE_LIMIT_ADMIN_MAX=20

# ──── Input sanitizer (defaults are fine) ─────────────────────────────────────
# INPUT_MAX_LENGTH=5000
# PASSWORD_MAX_LENGTH=128
# INPUT_MAX_DEPTH=10
# STRIP_TEMPLATE_SYNTAX=true

# ──── Security timings (defaults are fine) ────────────────────────────────────
# REPLAY_WINDOW_MS=300000
# NONCE_CLEANUP_INTERVAL=300000
# ORDER_IDEMPOTENCY_TTL_MS=60000
# ORDER_IDEMPOTENCY_STALE_MS=120000
# SAFE_REGEX_TIMEOUT_MS=100
